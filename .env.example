# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it.

# Required: get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: register free at https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional Groq fallback — get a free key at https://console.groq.com
# When set, "fast" agents (scoring, research, interview prep) use Groq.
# Anthropic falls back to Groq automatically if credits run out.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Circuit breaker (Anthropic → Groq failover)
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60

# Optional: defaults shown
ADZUNA_COUNTRY=us
MAX_JOBS_PER_SOURCE=25
MAX_UPLOAD_BYTES=5242880
